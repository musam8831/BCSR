    <!-- UX-01 onboarding -->
    <string name="welcome_title">A moment of remembrance</string>
    <string name="welcome_body">BCSR gently checks in with you and suggests verified du\'a and adhkar from the Qur\'an and Sahih Hadith.</string>
    <string name="how_title">How it works</string>
    <string name="how_body">BCSR asks how you are, never tells you how you feel. It never reads messages, what you type, or what is on your screen. Everything stays on your phone.</string>
    <string name="notif_title">Gentle reminders</string>
    <string name="notif_body">BCSR can send a short check-in now and then. It never sends one during quiet hours or around Salah times, and never names a feeling on the lock screen.</string>
